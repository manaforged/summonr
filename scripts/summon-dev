#!/bin/sh
set -u

self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname -- "$self")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
home=$(dirname -- "$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$root/.git")")
target="$root/target/summon-dev"
bin="$target/release/summonr"

built="$target/summon-dev.head"
head=$(git -C "$root" rev-parse HEAD 2>/dev/null)
watch="$root/src $root/Cargo.toml $root/Cargo.lock $root/build.rs $root/.git/HEAD"
patch=
for sibling in sigil-ui:sigil/crates/sigil leyline-http:leyline-http/crates/leyline; do
    crate=${sibling%%:*}
    repo=$(CDPATH= cd -- "$home/../${sibling#*:}" 2>/dev/null && pwd)
    if [ -n "$repo" ] && [ -f "$repo/Cargo.toml" ]; then
        patch="$patch --config patch.crates-io.$crate.path=\"$repo\""
        head="$head $(git -C "$repo" rev-parse HEAD 2>/dev/null)"
    fi
done

stale() {
    [ ! -x "$bin" ] && return 0
    [ "$head" = "$(cat "$built" 2>/dev/null)" ] || return 0
    for path in $watch; do
        [ -e "$path" ] || continue
        if [ -n "$(find "$path" -newer "$bin" -print -quit 2>/dev/null)" ]; then
            return 0
        fi
    done
    return 1
}

build() {
    CARGO_TARGET_DIR="$target" \
        CARGO_PROFILE_RELEASE_LTO=off \
        CARGO_PROFILE_RELEASE_CODEGEN_UNITS=256 \
        CARGO_PROFILE_RELEASE_INCREMENTAL=true \
        cargo build --manifest-path "$root/Cargo.toml" --release --bin summonr --features gui "$@" >&2
}

hold() {
    mkdir -p "$target" || return 1
    while ! mkdir "$target/build.lock" 2>/dev/null; do
        owner=$(cat "$target/build.lock/pid" 2>/dev/null)
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            rm -rf "$target/build.lock"
            continue
        fi
        sleep 1
    done
    echo $$ >"$target/build.lock/pid"
}

release() {
    rm -rf "$target/build.lock"
}

local_build() {
    cargo fetch --manifest-path "$root/Cargo.toml" >/dev/null 2>&1
    cp -p "$root/Cargo.lock" "$target/Cargo.lock.pin" || return 1
    trap 'cp -p "$target/Cargo.lock.pin" "$root/Cargo.lock"; release; exit 1' HUP INT TERM
    build $patch
    status=$?
    cp -p "$target/Cargo.lock.pin" "$root/Cargo.lock"
    trap - HUP INT TERM
    return $status
}

if [ -n "${SUMMONR_SESSION_ID:-}" ] && [ -x "$bin" ]; then
    exec "$bin" "$@"
fi

hold
if stale; then
    if [ -n "$patch" ]; then
        local_build
    else
        build --locked
    fi &&
        printf '%s\n' "$head" >"$built" ||
        echo "summonr: the build failed; starting the previous build at $bin" >&2
fi
release

[ -x "$bin" ] || exit 1
exec "$bin" "$@"
