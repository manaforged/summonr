(set-logic QF_UF)
(declare-const clear Bool)
(declare-const kill Bool)
(declare-const complete Bool)
(declare-const hidden Bool)
(declare-const running Bool)
(declare-const history Bool)
(declare-const known Bool)
(declare-const sibling-hidden Bool)
(define-fun hidden-next () Bool (or hidden (and known clear)))
(define-fun running-next () Bool (and running (not (and known (or kill complete)))))
(define-fun history-next () Bool history)
(define-fun sibling-hidden-next () Bool sibling-hidden)
(push)
(assert (and known clear (not kill) (not complete) (or (not (= running-next running)) (not (= history-next history)) (not (= sibling-hidden-next sibling-hidden)))))
(check-sat)
(pop)
(push)
(assert (and hidden (not hidden-next)))
(check-sat)
(pop)
(push)
(assert (and (not known) (not hidden) hidden-next))
(check-sat)
(pop)
(push)
(assert (not (= (or hidden-next (and known clear)) hidden-next)))
(check-sat)
(pop)
(push)
(assert (and known clear kill (or running-next (not hidden-next) (not (= history-next history)))))
(check-sat)
(pop)
