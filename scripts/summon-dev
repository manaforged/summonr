#!/bin/sh
# Run this checkout's newest build. Point your PATH at it once:
#   ln -sfn "$PWD/scripts/summon-dev" ~/.cargo/bin/summon
#   ln -sfn "$PWD/scripts/summon-dev" ~/.cargo/bin/summoner
# Rebuilds release when src/ or Cargo files are newer than the binary, then
# execs it, so the process identity stays target/release/summon.
set -u

self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname -- "$self")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
bin="$root/target/release/summon"

stale() {
    [ ! -x "$bin" ] && return 0
    for path in "$root/src" "$root/Cargo.toml" "$root/Cargo.lock" "$root/build.rs" "$root/.git/HEAD"; do
        [ -e "$path" ] || continue
        if [ -n "$(find "$path" -newer "$bin" -print -quit 2>/dev/null)" ]; then
            return 0
        fi
    done
    return 1
}

if stale; then
    cargo build --locked --manifest-path "$root/Cargo.toml" --release \
        --bin summon --bin summoner >&2 ||
        echo "summon: keeping the previous build" >&2
fi

exec "$bin" "$@"
