#!/bin/sh
set -u

self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname -- "$self")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
bin="$root/target/release/summonr"

stale() {
    [ ! -x "$bin" ] && return 0
    for path in "$root/src" "$root/Cargo.toml" "$root/Cargo.lock" "$root/build.rs" "$root/.git/HEAD"; do
        [ -e "$path" ] || continue
        if [ -n "$(find "$path" -newer "$bin" -print -quit 2>/dev/null)" ]; then
            return 0
        fi
    done
    return 1
}

lock="$root/target/summon-dev.lock"
log="$root/target/summon-dev.log"

if [ ! -x "$bin" ]; then
    cargo build --locked --manifest-path "$root/Cargo.toml" --release \
        --bin summonr >&2 || exit 1
elif stale; then
    if mkdir "$lock" 2>/dev/null; then
        nohup sh -c 'echo $$ >"$1/pid"; cargo build --locked --manifest-path "$2" --release --bin summonr >"$3" 2>&1; rm -rf "$1"' \
            sh "$lock" "$root/Cargo.toml" "$log" </dev/null >/dev/null 2>&1 &
        echo "summonr: rebuilding in the background; the next start uses it ($log)" >&2
    elif ! kill -0 "$(cat "$lock/pid" 2>/dev/null)" 2>/dev/null; then
        rm -rf "$lock"
    fi
fi

exec "$bin" "$@"
