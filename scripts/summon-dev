#!/bin/sh
set -u

self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname -- "$self")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
bin="$root/target/release/summonr"

stale() {
    [ ! -x "$bin" ] && return 0
    for path in "$root/src" "$root/Cargo.toml" "$root/Cargo.lock" "$root/build.rs" "$root/.git/HEAD"; do
        [ -e "$path" ] || continue
        if [ -n "$(find "$path" -newer "$bin" -print -quit 2>/dev/null)" ]; then
            return 0
        fi
    done
    return 1
}

if stale; then
    cargo build --locked --manifest-path "$root/Cargo.toml" --release \
        --bin summonr >&2 ||
        echo "summonr: keeping the previous build" >&2
fi

exec "$bin" "$@"
