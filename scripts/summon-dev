#!/bin/sh
set -u

self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname -- "$self")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
target="$root/target/summon-dev"
bin="$target/release/summonr"

built="$target/summon-dev.head"
head=$(git -C "$root" rev-parse HEAD 2>/dev/null)
sigil=$(CDPATH= cd -- "$root/../sigil" 2>/dev/null && pwd)
watch="$root/src $root/Cargo.toml $root/Cargo.lock $root/build.rs $root/.git/HEAD"
patch=
if [ -n "$sigil" ] && [ -f "$sigil/crates/sigil/Cargo.toml" ]; then
    url=$(sed -n 's/^sigil = .*git = "\([^"]*\)".*/\1/p' "$root/Cargo.toml")
    patch="patch.\"$url\".sigil-ui.path=\"$sigil/crates/sigil\""
    head="$head $(git -C "$sigil" rev-parse HEAD 2>/dev/null)"
    watch="$watch $sigil/crates/sigil/src $sigil/crates/sigil/Cargo.toml"
fi

stale() {
    [ ! -x "$bin" ] && return 0
    [ "$head" = "$(cat "$built" 2>/dev/null)" ] || return 0
    for path in $watch; do
        [ -e "$path" ] || continue
        if [ -n "$(find "$path" -newer "$bin" -print -quit 2>/dev/null)" ]; then
            return 0
        fi
    done
    return 1
}

build() {
    CARGO_TARGET_DIR="$target" \
        CARGO_PROFILE_RELEASE_LTO=off \
        CARGO_PROFILE_RELEASE_CODEGEN_UNITS=256 \
        CARGO_PROFILE_RELEASE_INCREMENTAL=true \
        cargo build --manifest-path "$root/Cargo.toml" --release --bin summonr "$@" >&2
}

hold() {
    mkdir -p "$target" || return 1
    while ! mkdir "$target/build.lock" 2>/dev/null; do
        owner=$(cat "$target/build.lock/pid" 2>/dev/null)
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            rm -rf "$target/build.lock"
            continue
        fi
        sleep 1
    done
    echo $$ >"$target/build.lock/pid"
}

release() {
    rm -rf "$target/build.lock"
}

local_build() {
    cargo fetch --manifest-path "$root/Cargo.toml" >/dev/null 2>&1
    cp -p "$root/Cargo.lock" "$target/Cargo.lock.pin" || return 1
    trap 'cp -p "$target/Cargo.lock.pin" "$root/Cargo.lock"; release; exit 1' HUP INT TERM
    build --config "$patch"
    status=$?
    cp -p "$target/Cargo.lock.pin" "$root/Cargo.lock"
    trap - HUP INT TERM
    return $status
}

hold
if stale; then
    if [ -n "$patch" ]; then
        local_build
    else
        build --locked
    fi &&
        printf '%s\n' "$head" >"$built" ||
        echo "summonr: the build failed; starting the previous build" >&2
fi
release

[ -x "$bin" ] || exit 1
exec "$bin" "$@"
