#!/bin/sh
set -u

self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname -- "$self")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
target="$root/target/summon-dev"
bin="$target/release/summonr"

stale() {
    [ ! -x "$bin" ] && return 0
    for path in "$root/src" "$root/Cargo.toml" "$root/Cargo.lock" "$root/build.rs" "$root/.git/HEAD"; do
        [ -e "$path" ] || continue
        if [ -n "$(find "$path" -newer "$bin" -print -quit 2>/dev/null)" ]; then
            return 0
        fi
    done
    return 1
}

if stale; then
    CARGO_TARGET_DIR="$target" \
        CARGO_PROFILE_RELEASE_LTO=off \
        CARGO_PROFILE_RELEASE_CODEGEN_UNITS=256 \
        CARGO_PROFILE_RELEASE_INCREMENTAL=true \
        cargo build --locked --manifest-path "$root/Cargo.toml" --release \
        --bin summonr >&2 ||
        echo "summonr: the build failed; starting the previous build" >&2
fi

[ -x "$bin" ] || exit 1
exec "$bin" "$@"
